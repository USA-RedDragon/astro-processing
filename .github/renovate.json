{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": [
        "local>USA-RedDragon/renovate-configs",
        "local>USA-RedDragon/renovate-configs:golang"
    ],
    "packageRules": [
        {
            "description": "graphqlsp, vue-tsc and typescript-eslint support TypeScript up to 6",
            "matchPackageNames": ["typescript"],
            "allowedVersions": "<7"
        },
        {
            "description": "graphql-request supports graphql 14-16",
            "matchPackageNames": ["graphql"],
            "allowedVersions": "<17"
        },
        {
            "description": "gqlgen bumps change the generated code, so go generate ./... must be committed with them; the lint check is not required, so automerge would land the drift",
            "matchPackageNames": ["github.com/99designs/gqlgen"],
            "automerge": false
        }
    ]
}
