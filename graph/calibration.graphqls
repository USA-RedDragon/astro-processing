extend type Query {
  "Dark library setpoints that lights need but no darks cover. Empty when the worker is not configured."
  darkLibraryGaps: [DarkLibraryGap!]!
}

enum CalibrationQuality {
  EXACT
  FALLBACK
  MISSING
}

type CalibrationMatch {
  quality: CalibrationQuality!
  "Night the calibration frames were taken."
  night: String
  frames: Int
  "Nights between the lights and the calibration."
  age_days: Int!
  "Dark setpoint difference in °C."
  temp_off: Float
  "Dark setpoint in °C."
  set_temp: Float
  "The flat was taken at another rotator angle."
  rotation_mismatch: Boolean!
  "The dark's thermal signal must be scaled to the lights."
  scaled: Boolean!
}

"One night of lights sharing a filter and camera settings, with its calibration."
type CalibrationRow {
  night: String!
  filter: String!
  exposure: Float!
  gain: Float
  offset: Float
  set_temp: Float
  rotator: Float
  lights: Int!
  flat: CalibrationMatch!
  dark: CalibrationMatch!
  bias: CalibrationMatch!
}

type DarkLibraryGap {
  gain: Float
  offset: Float
  set_temp: Float!
  lights: Int!
  nights: Int!
  latest_night: String!
}

"The well-covered part of an image, as fractions of its width and height."
type Crop {
  x: Float!
  y: Float!
  w: Float!
  h: Float!
}

"One filter's mosaic of a project's panel masters, plate solved and blended."
type Mosaic {
  filter: String!
  "Panels in the mosaic, of all the project's panels."
  panels: Int!
  panels_total: Int!
  width: Int!
  height: Int!
  updated_at: String!
  "Presigned link to the linear mosaic FITS, valid for an hour."
  master_url: String!
  "Presigned link to the auto-stretched JPEG."
  preview_url: String!
  "Presigned link to the gzipped linear preview (APLP format) for palette mixing."
  linear_url: String!
  "Where the preview is cropped to; the linear preview and FITS are whole."
  crop: Crop
}

"One filter's stacked master for a target: only subs that scored well, added as they arrive."
type FilterMaster {
  filter: String!
  subs: Int!
  exposure_hours: Float!
  "Exposure weighted by sub score."
  effective_hours: Float!
  width: Int!
  height: Int!
  updated_at: String!
  "Presigned link to the linear master FITS, valid for an hour."
  master_url: String!
  "Presigned link to the auto-stretched JPEG."
  preview_url: String!
  "Presigned link to the gzipped linear preview (APLP format) for palette mixing."
  linear_url: String!
  "Where the preview is cropped to; the linear preview and FITS are whole."
  crop: Crop
  "Presigned link to the master as XISF, which PixInsight opens upright and plate solved."
  xisf_url: String
  "Presigned link to the master linear fitted to fit_reference, when the target has other colour or other narrowband filters to match."
  fitted_url: String
  "The filter the linear fitted master is matched to."
  fit_reference: String
  "A comet's master aligned on the comet: preview, FITS and XISF links."
  comet_preview_url: String
  comet_url: String
  comet_xisf_url: String
  "The stacker's min score: subs under it times the target's best score in the filter are left out."
  min_score: Float
  "The lowest score of the subs in the master."
  lowest_score: Float
  "Lights in this filter the stacker has under the master's object name, of any Target Scheduler target or none. Null outside a target page."
  object_lights: Int
  "Subs in the master that are this Target Scheduler target's. Null outside a target page."
  target_subs: Int
}
