extend type Query {
  targets(orderBy: TargetOrderBy): [Target!]!
  target(id: ID!): Target
}

enum TargetOrderField {
  NAME
  LAST_IMAGE_DATE
  ACTIVE
  PROGRESS
}

input TargetOrderBy {
  field: TargetOrderField!
  direction: ORDER_DIRECTION!
}

enum Epoch {
  JNOW
  B1950
  J2000
  J2050
}

type Target {
  id: ID!
  name: String!
  active: Boolean!
  ra: Float
  dec: Float
  epoch: Epoch!
  rotation: Float!
  region_of_interest: Float!
  project: Project
  stats: TargetStats!
  "Every acquired sub for this target, with the stacker's score and status."
  subframes: [Subframe!]!
  "Calibration coverage per night of lights, newest first. Empty when the worker is not configured."
  calibration: [CalibrationRow!]!
  "Stacked masters, one per filter. Empty when the stacker is not configured."
  masters: [FilterMaster!]!
}

type TargetStats {
  last_image_date: Int
  total: ImagingStats!
  filters: [TargetFilterStats!]!
  "Nominal versus effective integration per filter and exposure length."
  quality: [FilterQuality!]!
}

"One exposure plan of the target, with its images counted by plan."
type TargetFilterStats {
  filter_name: String!
  "The exposure template the plan uses."
  template_name: String
  "The plan's exposure in seconds: its own when set, else the template's default."
  exposure: Float
  "plan or template: where the exposure comes from."
  exposure_source: String
  "Null when the plan has no enabled value."
  enabled: Boolean
  gain: Int
  offset: Int
  imaging: ImagingStats!
}

enum GradingStatus {
  PENDING
  ACCEPTED
  REJECTED
}

"""
A sub as astro-stacker judged it. Its score, weight and status are the
stacker's own, so this page always agrees with what is in the masters.
"""
type Subframe {
  id: ID!
  acquired_date: Int
  filter_name: String!
  exposure_time: Float
  grading_status: GradingStatus!
  reject_reason: String
  file_name: String
  "ADU median above the camera pedestal, adjusted for the sub's offset."
  sky: Float
  hfr: Float
  fwhm: Float
  stars: Int
  eccentricity: Float
  guiding_rms_arcsec: Float
  airmass: Float
  """
  The stacker's score: the sub's worth against the best tenth of subs for its
  filter and exposure, times its transparency squared. Null until the stacker
  has processed the sub.
  """
  score: Float
  "What the sub adds to its master, score × exposure in seconds. Null until processed."
  weight: Float
  """
  What the stacker made of the sub: pending (not processed yet), added,
  low_score, moon, off_target, rejected (in Target Scheduler, not by the
  stacker), no_metadata, calibration, registration, failed, dead,
  recalibrate or duplicate.
  """
  stack_status: String!
  "Why the sub is not in its master, or what it waits for. Null for a stacked sub."
  stack_reason: String
  """
  Whether the stacker's star photometry is in the sub's transparency yet:
  pending, measured or failed. Null when the stacker has no such file.
  """
  photometry: String
  "Presigned link to an auto-stretched JPEG of the sub, valid for an hour. Null until the worker has rendered it."
  preview_url: String
}

type FilterQuality {
  filter_name: String!
  exposure_time: Float!
  "Subs the stacker judges: all but those Target Scheduler rejected itself, and duplicate files."
  subframes: Int!
  "Subs the stacker put in the master."
  stacked: Int!
  "Subs the stacker hasn't processed yet."
  pending: Int!
  nominal_hours: Float!
  "The stacker's weights (score × exposure) of the subs it stacked: hours of good-conditions data in the master."
  effective_hours: Float!
  median_sky: Float
  median_hfr: Float
}
